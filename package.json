{
  "name": "@sito/feature-usage",
  "version": "0.1.0-alpha.2",
  "description": "Anonymous feature usage tracking for Sito applications (client for sito-feature-usage)",
  "author": "Sito",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sito8943/sito-feature-usage-js.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "29.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rollup": "^4.0.0",
    "tslib": "^2.8.0",
    "typescript": "^6.0.0",
    "vitest": "4.1.12"
  }
}
